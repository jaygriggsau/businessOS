# Copy to .env for local testing, or set these as environment variables /
# secrets on your host (Render, Fly.io, Railway, a VPS, …).
#
# NEVER commit real values. .env is gitignored.

# Your Anthropic API key. Create a FRESH one at console.anthropic.com and
# paste it here. Do not reuse a key you've shared anywhere.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated access codes the app must send to use the proxy.
# Give each customer/device their own code so you can revoke individually.
ACCESS_CODES=team-alpha-7f3a,shop-two-9k2p

# Requests allowed per minute, per access code.
RATE_LIMIT_PER_MIN=20

# Optional hard cap on total requests per code per day (0 = unlimited).
DAILY_LIMIT=200

# Port to listen on (most hosts set this automatically).
PORT=8787

# Set to "true" ONLY to run without access codes (anyone can spend your
# credits). Strongly discouraged.
# ALLOW_OPEN=false
